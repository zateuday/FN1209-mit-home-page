.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-top:-34px}
.stat{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:18px;text-align:center;box-shadow:0 6px 18px rgba(0,0,0,.08)}
